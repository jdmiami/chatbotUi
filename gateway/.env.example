# ---- Shared with the Vercel app (must be identical in both places) ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GATEWAY_SECRET=

# Only accept tunnels opened from your Vercel site (comma separated, no trailing slash).
# Comma separated. "*" matches one run of letters/digits/dashes (never a dot), e.g.
# https://your-app-*-your-team.vercel.app covers your project's deployment and branch addresses.
ALLOWED_ORIGINS=https://your-app.vercel.app

# ---- The Windows PC to connect to ----
# host.docker.internal = the machine running Docker. Otherwise use the PC's LAN IP, e.g. 192.168.1.50
RDP_HOST=host.docker.internal
RDP_PORT=3389
RDP_USERNAME=
RDP_PASSWORD=
# Leave empty for a local account. For a Microsoft account, use the email as RDP_USERNAME.
RDP_DOMAIN=
# any | nla | tls | rdp
RDP_SECURITY=any
# Windows uses a self-signed certificate by default.
RDP_IGNORE_CERT=true
RDP_ENABLE_AUDIO=true
RDP_ENABLE_CLIPBOARD=true
RDP_ENABLE_WALLPAPER=false
# e.g. en-us-qwerty, en-gb-qwerty, de-de-qwertz, fr-fr-azerty, es-es-qwerty
RDP_KEYBOARD_LAYOUT=en-us-qwerty
# e.g. America/New_York
RDP_TIMEZONE=

# ---- Cloudflare Tunnel (only with: docker compose --profile tunnel up -d) ----
CLOUDFLARE_TUNNEL_TOKEN=
