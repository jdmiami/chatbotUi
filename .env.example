# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Login
AUTH_USERNAME=admin
# npm run hash-password -- "a long password"
AUTH_PASSWORD_HASH=
# Optional 2-factor auth (strongly recommended): npm run setup-2fa -- admin
TOTP_SECRET=

# npm run gen-secret
SESSION_SECRET=
SESSION_HOURS=12

# Each computer has its own gateway URL and shared secret. Leave a pair empty to hide that computer.

# Windows PC: your Cloudflare Tunnel hostname. Must match GATEWAY_SECRET in gateway/.env.
GATEWAY_URL=wss://rdp-gateway.example.com
GATEWAY_SECRET=

# Linux desktop (see linux/README.md): wss://<pod-id>-8080.proxy.runpod.net
# Must match GATEWAY_SECRET in the pod's environment.
LINUX_GATEWAY_URL=
LINUX_GATEWAY_SECRET=

# Linux machine power (Orbit and the chooser's "Turn on / Turn off" button).
# The Runpod pod id (e.g. r5i208t5g89izc). Orbit reaches it at https://<pod-id>-8080.proxy.runpod.net.
LINUX_POD_ID=
# Runpod API key (Runpod console → Settings → API Keys). Stays on the server; without it the site
# can still connect, but can't show whether the machine is on or turn it on/off.
RUNPOD_API_KEY=
# When the Linux machine's data center (its saved drive) has no free machine, a stand-in without the
# drive starts elsewhere in the US. Optional: LINUX_FALLBACK_NAME (orbit-linux-fallback),
# LINUX_FALLBACK_DATA_CENTERS (comma-separated, defaults to the US Secure Cloud data centers).

# Auto-off: every Runpod machine (the AI machine, its helper, every speed, Live Draw's drawing machine,
# the Linux machine and its stand-in) turns itself off after this many minutes unused. 10 to 60, default 60 (never longer).
# One number for all of them; the site sends it to each machine when it turns it on (lib/autoOff.ts).
# Replaces AI_IDLE_MINUTES (still read if this is not set).
# AUTO_OFF_MINUTES=60

# AI machine (ai/README.md): a Runpod GPU pod with Open WebUI + Ollama that the site turns on when you
# open the AI playground and that turns itself off when unused. Uses RUNPOD_API_KEY and
# LINUX_GATEWAY_SECRET from above.
# Models, chats and creations are kept in Cloudflare R2 (Runpod secrets r2_account_id,
# r2_access_key_id, r2_secret_access_key); no network volume needed.
# Optional (defaults shown):
# AI_POD_NAME=orbit-ai
# AI_GPU_TYPES=NVIDIA A40,NVIDIA RTX A6000
# AI_DATA_CENTERS=US-NC-1,US-NC-2,...   (North American data centers, in order of preference)
# Old way: a network volume mounted at /workspace (GPU and data center must match it).
# AI_STORAGE=volume
# AI_VOLUME_ID=
# AI_DATA_CENTER=CA-MTL-1
# AI_IMAGE=ghcr.io/open-webui/open-webui:0.12.2-ollama
# AI_MODELS=qwen3.8:27b,qwen3.6:35b,qwen3.8-obliterated:27b=hf.co/OBLITERATUS/Qwen3.8-27B-OBLITERATED:Q6_K|like=qwen3.8:27b|temperature=0|repeat_penalty=1.15
# Gated video models (LTX-2.5): the name of a Runpod secret holding a Hugging Face token that accepted
# the model's licence. Passed to the AI machine as HF_TOKEN; without it the store says it needs a token.
# AI_HF_TOKEN_SECRET=hf_token
# Without RUNPOD_API_KEY, AI_POD_ID pins one machine the site uses whenever it is on.
# AI_POD_ID=

# Drawing machine (Live Draw, docs/livedraw/DESIGN.md): its own GPU pod named <AI_POD_NAME>-canvas, same
# image and sign-in as the AI machine (uses RUNPOD_API_KEY, LINUX_GATEWAY_SECRET, the R2 secrets for the
# gallery and AI_HF_TOKEN_SECRET). Model files and packed software stay on a Runpod global volume (its
# id here), so the pod starts in whichever data centre has a GPU free. Required to turn it on:
# CANVAS_GLOBAL_VOLUME_ID=
# Optional (defaults: the AI machine's North American data centres, then the GPUs shown):
# CANVAS_DATA_CENTERS=US-NC-1,US-NC-2,...
# CANVAS_GPU_TYPES=NVIDIA H200,NVIDIA RTX PRO 6000 Blackwell Server Edition
# Price shown before Start (default: Runpod's Secure Cloud price for the GPU, else 5.29):
# CANVAS_PRICE_PER_HOUR=5.29
