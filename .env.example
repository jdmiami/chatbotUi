# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Login
AUTH_USERNAME=admin
# npm run hash-password -- "a long password"
AUTH_PASSWORD_HASH=
# Optional 2-factor auth (strongly recommended): npm run setup-2fa -- admin
TOTP_SECRET=

# npm run gen-secret
SESSION_SECRET=
SESSION_HOURS=12

# Where the browser reaches the gateway (your Cloudflare Tunnel hostname), and the shared secret.
GATEWAY_URL=wss://rdp-gateway.example.com
# Must match GATEWAY_SECRET in gateway/.env.  npm run gen-secret
GATEWAY_SECRET=
