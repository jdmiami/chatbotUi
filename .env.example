# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Login
AUTH_USERNAME=admin
# npm run hash-password -- "a long password"
AUTH_PASSWORD_HASH=
# Optional 2-factor auth (strongly recommended): npm run setup-2fa -- admin
TOTP_SECRET=

# npm run gen-secret
SESSION_SECRET=
SESSION_HOURS=12

# Each computer has its own gateway URL and shared secret. Leave a pair empty to hide that computer.

# Windows PC: your Cloudflare Tunnel hostname. Must match GATEWAY_SECRET in gateway/.env.
GATEWAY_URL=wss://rdp-gateway.example.com
GATEWAY_SECRET=

# Linux desktop (see linux/README.md): wss://<pod-id>-8080.proxy.runpod.net
# Must match GATEWAY_SECRET in the pod's environment.
LINUX_GATEWAY_URL=
LINUX_GATEWAY_SECRET=
