{
  "name": "orbit-design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OrbitDesign: the Orbit look, motion and orb, as a package for new apps. No AI inside; the orb takes any AI through one adapter.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
